# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in the values. NEVER commit ".env".
# In CI, provide these as pipeline secrets / environment variables instead.
# ---------------------------------------------------------------------------

# Application URLs
BASE_URL=https://smartgovcivit.com
# Optional. URL asserted by "TC01 - Verify MIDC portal loads". Defaults to BASE_URL + "/".
MIDC_HOME_URL=
ADMIN_URL=https://admin.smartgovcivit.com

# Department Login credentials (REQUIRED for every scenario that logs in)
# Single-quote a password that contains $, @, # or spaces, e.g. MIDC_PASSWORD='$Ex@mple1234'
MIDC_USERNAME=
MIDC_PASSWORD=

# Optional: a view-only Designation Management user. Without it, TC_CivitCORE_F_0004 is skipped.
MIDC_VIEWER_USERNAME=
MIDC_VIEWER_PASSWORD=

# Designation Management (features/designation_management_features)
# Office whose Position list stands in for the FRD "Post" lookup; scenarios add 1 Position there
# to a temporary Designation and remove it again.
POSITION_OFFICE_CATEGORY=Head Office
POSITION_OFFICE=Engineering
# true = assert the FRD message copy verbatim instead of the app's equivalent wording
STRICT_FRD_MESSAGES=false

# Browser settings
BROWSER=chromium            # chromium | firefox | webkit
HEADLESS=true
SLOW_MO_MS=0
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=720
# Optional: absolute path to a browser executable (leave empty to use Playwright's bundled browser)
BROWSER_EXECUTABLE_PATH=

# Timeouts (milliseconds)
EXPECT_TIMEOUT_MS=5000      # default for assertions without an explicit timeout (Playwright default)
ACTION_TIMEOUT_MS=0         # 0 = no limit (Playwright Test default for actions)
NAVIGATION_TIMEOUT_MS=30000
STEP_TIMEOUT_MS=120000      # Cucumber per-step timeout
AUTH_ERROR_PROBE_TIMEOUT_MS=10000

# Artefacts (captured for every scenario by default and attached to the HTML / Allure reports)
SCREENSHOT=on               # off | on | retain-on-failure
TRACE=on                    # off | on | retain-on-failure
VIDEO=on                    # off | on | retain-on-failure
ATTACH_ARTIFACTS=true       # embed the files in the Cucumber HTML and Allure reports

# Reports
ALLURE_RESULTS_DIR=allure-results
ALLURE_REPORT_DIR=allure-report

# Execution
PARALLEL=1
RETRY=0

# Location Category Management (features/location_category_features). Optional extra users for the
# permission scenarios; each scenario is skipped when its user is not configured.
MIDC_EDITOR_USERNAME=
MIDC_EDITOR_PASSWORD=
MIDC_NOACCESS_USERNAME=
MIDC_NOACCESS_PASSWORD=
MIDC_AUDITOR_USERNAME=
MIDC_AUDITOR_PASSWORD=
