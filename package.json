{
  "name": "midc-department-cucumber-bdd",
  "version": "1.0.0",
  "private": true,
  "description": "Cucumber BDD (Playwright + TypeScript) suite for the MIDC / CivitCORE Department Management module, converted from the original Playwright Test specs.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "playwright install chromium firefox webkit",
    "install:browsers": "playwright install",
    "test": "cucumber-js",
    "test:headed": "cross-env HEADLESS=false cucumber-js",
    "test:dry-run": "cucumber-js --dry-run",
    "test:login": "cucumber-js --tags @department-login",
    "test:masters": "cucumber-js --tags @masters-management",
    "test:add": "cucumber-js --tags @add-department",
    "test:nested": "cucumber-js --tags @nested-department",
    "test:edit": "cucumber-js --tags @edit-department",
    "test:delete": "cucumber-js --tags @delete-department",
    "test:navigation": "cucumber-js --tags @department-navigation",
    "test:verified": "cucumber-js --tags @verified-behavior",
    "test:negative": "cucumber-js --tags @negative",
    "test:search": "cucumber-js --tags @search-department",
    "test:designation": "cucumber-js --tags @Designation",
    "test:location-category": "cucumber-js --tags @location_category",
    "test:logout": "cucumber-js --tags \"@logout and not @shared-session\"",
    "test:sequential": "cross-env SHARED_SESSION=1 cucumber-js -p sequential",
    "test:sequential:headed": "cross-env SHARED_SESSION=1 HEADLESS=false cucumber-js -p sequential",
    "test:designation:sequential": "cross-env SHARED_SESSION=1 cucumber-js -p designation-sequential",
    "test:designation:sequential:headed": "cross-env SHARED_SESSION=1 HEADLESS=false cucumber-js -p designation-sequential",
    "test:location-category:sequential": "cross-env SHARED_SESSION=1 cucumber-js -p location-category-sequential",
    "test:location-category:sequential:headed": "cross-env SHARED_SESSION=1 HEADLESS=false cucumber-js -p location-category-sequential",
    "test:parallel": "cross-env PARALLEL=4 cucumber-js",
    "test:chromium": "node scripts/run-browsers.js chromium",
    "test:firefox": "node scripts/run-browsers.js firefox",
    "test:webkit": "node scripts/run-browsers.js webkit",
    "test:all-browsers": "node scripts/run-browsers.js chromium firefox webkit",
    "test:all-browsers:serial": "node scripts/run-browsers.js --serial chromium firefox webkit",
    "test:all-browsers:headed": "cross-env HEADLESS=false node scripts/run-browsers.js chromium firefox webkit",
    "test:all-browsers:headed:serial": "cross-env HEADLESS=false node scripts/run-browsers.js --serial chromium firefox webkit",
    "test:report": "node scripts/run-tests.js",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "allure:serve": "allure serve allure-results",
    "report:open": "node scripts/open-html-report.js",
    "typecheck": "tsc --noEmit",
    "quiet": "node scripts/quiet.js",
    "clean:reports": "rimraf reports allure-results allure-report"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.0",
    "allure-commandline": "^2.46.1",
    "allure-cucumberjs": "^3.12.2",
    "cross-env": "^10.1.0",
    "dotenv": "^16.6.1",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
